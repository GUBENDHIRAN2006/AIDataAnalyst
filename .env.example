# =============================================================================
# AI Data Analyst - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Groq ---
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Groq-hosted model (GPT-OSS 120B supports tool calling)
GROQ_MODEL=openai/gpt-oss-120b

# Maximum tokens per response
GROQ_MAX_TOKENS=4096

# --- Optional accounts and saved analysis history (Supabase) ---
# Configure these to enable optional email/password registration and login.
# Use the project's anon/publishable key, never its service-role key.
# History rows are protected by the RLS policies in supabase/analysis_history.sql.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Internal FastAPI backend ---
# Set the same random value for the Streamlit frontend and FastAPI service.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_API_URL=http://127.0.0.1:8000
APP_API_KEY=replace-with-a-long-random-secret

# --- File Upload Limits ---
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS=500000
MAX_COLUMNS=200

# --- Agent Behavior ---
MAX_TOOL_CALLS=10
API_TIMEOUT_SECONDS=60

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_RESULT_ROWS=1000
MAX_CHART_CATEGORIES=50
